{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bidforge.canonical.v1",
  "title": "NTXP CPM Gantt Schedules Canonical Project Schedule",
  "description": "Produced by web/src/utils/canonical.js buildCanonicalDocument(). Knowledge base, Drive and JobTread copies are derived from this document.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "project",
    "requirements",
    "wbs",
    "dependencies",
    "changelog"
  ],
  "properties": {
    "schema": {
      "const": "bidforge.canonical.v1"
    },
    "generatedAt": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 0
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "slug",
        "startDate"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "startDate": {
          "type": "string"
        },
        "endDate": {
          "type": "string"
        },
        "workingDays": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "holidays": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "jobtreadJobId": {
          "type": "string"
        },
        "driveFolderId": {
          "type": "string"
        },
        "driveFolderName": {
          "type": "string"
        },
        "quickbooksProjectId": {
          "type": "string"
        },
        "kbPath": {
          "type": "string"
        },
        "hostUrl": {
          "type": "string"
        }
      }
    },
    "requirements": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "uploaded",
            "acknowledged_none"
          ]
        },
        "documents": {
          "type": "array"
        },
        "specText": {
          "type": "string"
        },
        "detected": {
          "type": "array"
        },
        "acknowledgement": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "confirmed",
              "declined"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "wbs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "children"
        ],
        "properties": {
          "phaseKey": {
            "enum": [
              "preconstruction",
              "construction",
              "closeout"
            ]
          },
          "children": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "duration"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "duration": {
                  "type": "number"
                },
                "trade": {
                  "type": "string"
                },
                "category": {
                  "enum": [
                    "activity",
                    "deliverable",
                    "delivery",
                    "procurement"
                  ]
                },
                "sub": {
                  "type": "string"
                },
                "cls": {
                  "type": "string"
                },
                "csi": {
                  "type": "string"
                },
                "hasSubmittal": {
                  "type": "boolean"
                },
                "leadDays": {
                  "type": "number"
                },
                "isMilestone": {
                  "type": "boolean"
                },
                "protected": {
                  "type": "boolean"
                },
                "module": {
                  "type": [
                    "array",
                    "null"
                  ]
                },
                "startDate": {
                  "type": "string"
                },
                "endDate": {
                  "type": "string"
                },
                "actualStart": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "actualFinish": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "constraintStart": {
                  "type": "string"
                },
                "contractDate": {
                  "type": "string"
                },
                "percentComplete": {
                  "type": "number"
                },
                "predecessors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "jobTreadTaskId": {
                  "type": "string"
                },
                "lesson": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array"
    },
    "trackers": {
      "type": "object"
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "at",
          "type"
        ]
      }
    },
    "inputs": {
      "type": "array"
    },
    "optimizationChain": {
      "type": "array"
    },
    "memory": {
      "type": "array"
    },
    "sync": {
      "type": "object",
      "properties": {
        "lastSyncAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastJobtreadPullAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "codaBackup": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "never",
                "pending",
                "written",
                "unchanged",
                "mismatch",
                "failed",
                "skipped"
              ]
            },
            "lastAt": {
              "type": [
                "string",
                "null"
              ]
            },
            "lastHash": {
              "type": [
                "string",
                "null"
              ]
            },
            "failures": {
              "type": "integer"
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "coda": {
      "type": "object",
      "description": "Project Coda (primary copy lives in the project KB; backed up to JobTread job custom field 'Notes' on every sync).",
      "properties": {
        "canonicalSchedule": {
          "type": "string"
        },
        "kb": {
          "type": "string"
        },
        "drive": {
          "type": "string"
        },
        "jobtread": {
          "type": "string"
        },
        "quickbooks": {
          "type": "string"
        },
        "hosted": {
          "type": "string"
        },
        "meetingSources": {
          "type": "string"
        },
        "models": {
          "type": "string"
        },
        "syncCadence": {
          "type": "string"
        },
        "council": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        }
      }
    }
  }
}
