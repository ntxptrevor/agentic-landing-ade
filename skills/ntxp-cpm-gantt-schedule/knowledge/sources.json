  "staleAfterDays": 7,
  "notes": "Environment-scan registry (references/environment-scan-and-crosswalk.md). env_scan.mjs plan prints the connector call for each source; env_scan.mjs register records lastScanAt and newly discovered sources. Drive folder ids are filled the first time a scan resolves the folder by name (folderId null = resolve by name).",
  "sources": [
    {
      "id": "jobtread-jobs",
      "kind": "jobtread",
      "title": "JobTread jobs (org 22PEKtgSScq2)",
      "tool": "mcp__JobTread__query",
      "candidatesKey": "jobtread",
      "args": {
        "query": {
          "organization": {
            "$": { "id": "22PEKtgSScq2" },
            "jobs": {
              "$": { "size": 100, "sortBy": [{ "field": "createdAt", "order": "desc" }] },
              "nodes": { "id": {}, "name": {}, "number": {}, "closedOn": {}, "location": { "address": {} }, "customer": { "name": {} } },
              "nextPage": {}
            }
          }
        }
      },
      "map": "nodes → {id, name, number, address: location.address, owner: customer.name, archived: !!closedOn}",
      "lastScanAt": null
    },
    {
      "id": "jobtread-notes-field",
      "kind": "jobtread",
      "title": "JobTread job custom field \"Notes\" (Project Coda backup, field 22PEPTyrwL4W)",
      "tool": "mcp__JobTread__query",
      "args": { "query": { "job": { "$": { "id": "{jobtreadJobId}" }, "customFieldValues": { "$": { "size": 50 }, "nodes": { "value": {}, "customField": { "name": {} } } } } } },
      "lastScanAt": null
    },
    {
