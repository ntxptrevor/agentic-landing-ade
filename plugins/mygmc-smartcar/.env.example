# Smartcar application credentials (from https://dashboard.smartcar.com)
SMARTCAR_CLIENT_ID=your-client-id
SMARTCAR_CLIENT_SECRET=your-client-secret

# Must exactly match a redirect URI registered on your Smartcar app.
# For local testing the Smartcar-hosted callback is convenient:
SMARTCAR_REDIRECT_URI=https://example.com/callback

# Connect mode: live (real vehicles), test, or simulated.
SMARTCAR_MODE=live

# Unit system for distance/range values: imperial or metric.
SMARTCAR_UNIT_SYSTEM=imperial

# Optional: pin a specific vehicle so tools don't have to look it up.
# SMARTCAR_VEHICLE_ID=

# Optional: override where OAuth tokens are cached on disk.
# SMARTCAR_TOKEN_PATH=~/.mygmc-smartcar/tokens.json

# Optional: override the API base URL (defaults to https://api.smartcar.com/v2.0).
# SMARTCAR_API_BASE=https://api.smartcar.com/v2.0
